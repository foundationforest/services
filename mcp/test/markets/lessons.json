{
  "name": "lessons",
  "summary": "Tutors teach school subjects one on one.",
  "description": "Lessons are paid by the hour or by the month, in person or online.",
  "status": "beta",
  "icon": "graduation-cap",
  "number": 1,
  "roles": [
    { "role": "tutor", "listings": "offers" },
    { "role": "student", "listings": "requests" }
  ],
  "listing": {
    "description": {
      "piece": "text",
      "ask": { "label": "About", "long": true, "as": { "tutor": { "question": "What should students know?" }, "student": { "question": "What should the tutor know?" } } }
    },
    "price": {
      "piece": "price",
      "per": ["hour", "month"],
      "ask": { "question": "What do you charge?", "as": { "student": { "label": "Budget", "question": "What would you pay at most?" } } }
    },
    "subjects": { "piece": "choice", "values": ["maths", "physics", "chemistry", "biology"], "several": true },
    "languages": { "piece": "choice", "values": "languages", "several": true, "ask": { "question": "Which languages are the lessons in?" } },
    "levels": { "piece": "choice", "values": ["primary", "secondary", "university", "adult"], "several": true, "ask": { "labels": { "primary": "primary school", "adult": "adults" } } },
    "minutes": { "piece": "number", "unit": "minutes", "ask": { "label": "Lesson length" } },
    "ages": { "piece": "number", "unit": "years", "ask": { "start": { "range": true } } },
    "mode": { "piece": "choice", "values": ["in-person", "online"], "several": true },
    "place": {
      "piece": "place",
      "when": { "mode": ["in-person"] },
      "ask": { "label": "Area", "start": { "radiusKm": 5 }, "as": { "student": { "hint": "Your neighbourhood and town, not your address.", "start": { "radiusKm": 2 } } } }
    },
    "hours": { "piece": "date", "several": true, "ask": { "label": "Days and times", "start": { "way": "weekly", "hours": true } } }
  },
  "preview": ["subjects", "description", "price", "mode", "place"],
  "review": {
    "paid": { "piece": "choice", "values": ["yes", "no"], "roles": ["student"], "ask": { "question": "Did they pay as agreed?" } }
  }
}
