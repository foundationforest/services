{
  "name": "@forest/issuer",
  "version": "0.0.0",
  "private": true,
  "description": "The Forest Foundation's issuer: it keeps two lists. A passed Didit face check puts a stamp on the face list, a passed face and ID check on the ID list, in shuffled batches; each list and its snapshots, signed with that list's key, are published as one file.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "fetch": "node --disable-warning=ExperimentalWarning scripts/fetch.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/issuer.test.ts test/didit.test.ts test/payment.test.ts test/face.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@semaphore-protocol/group": "4.12.1",
    "jpeg-js": "0.4.4",
    "onnxruntime-web": "1.30.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pngjs": "6.0.5",
    "typescript": "5.9.3"
  }
}
