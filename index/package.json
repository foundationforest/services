{
  "name": "@forest/index",
  "version": "0.0.0",
  "private": true,
  "description": "The Forest Foundation's index: reads the hosts it lists, keeps the profiles whose verification checks for a verifier key it lists, ranks them by one ranking, and serves what it finds as JSON and as pages, each page drawn from its JSON. One process over one SQLite file.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "rebuild": "node --disable-warning=ExperimentalWarning src/main.ts rebuild",
    "test": "node --disable-warning=ExperimentalWarning --test --test-force-exit --test-concurrency=1 test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@foundationforest/folders": "file:../standard/folders",
    "@foundationforest/keys": "file:../standard/keys",
    "@foundationforest/markets": "file:../markets/build",
    "@foundationforest/proofs": "file:../standard/proofs"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "5.9.3"
  }
}
