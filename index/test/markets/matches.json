{
  "name": "matches",
  "summary": "Players find someone to play a match with.",
  "description": "No money passes between them.",
  "status": "beta",
  "number": 2,
  "roles": [
    { "role": "player", "listings": "requests" }
  ],
  "listing": {
    "description": { "piece": "text" },
    "courts": { "piece": "place", "several": true, "ask": { "start": { "radiusKm": 1 } } },
    "time": { "piece": "date", "ask": { "label": "When" } },
    "level": { "piece": "choice", "values": ["beginner", "intermediate", "advanced"] }
  },
  "preview": ["description", "time", "courts", "level"],
  "review": {
    "showedUp": { "piece": "choice", "values": ["yes", "no"], "ask": { "question": "Did they come to the match as agreed?" } }
  }
}
