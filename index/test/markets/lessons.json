{
  "name": "lessons",
  "summary": "Tutors teach school subjects one on one.",
  "description": "Lessons are paid by the hour or by the month, in person or online.",
  "status": "beta",
  "icon": "graduation-cap",
  "number": 1,
  "roles": [
    { "role": "tutor", "listings": "offers" },
    { "role": "student", "listings": "requests" }
  ],
  "listing": {
    "description": { "piece": "text", "ask": { "long": true } },
    "price": { "piece": "price", "per": ["hour", "month"], "ask": { "as": { "student": { "label": "Budget" } } } },
    "subjects": { "piece": "choice", "values": ["maths", "physics", "chemistry", "biology"], "several": true },
    "languages": { "piece": "choice", "values": "languages", "several": true },
    "levels": { "piece": "choice", "values": ["primary", "secondary", "university", "adult"], "several": true, "ask": { "labels": { "adult": "adults" } } },
    "minutes": { "piece": "number", "unit": "minutes", "ask": { "label": "Lesson length" } },
    "ages": { "piece": "number", "unit": "years", "ask": { "start": { "range": true } } },
    "groupSize": { "piece": "number", "roles": ["tutor"] },
    "mode": { "piece": "choice", "values": ["in-person", "online"], "several": true, "ask": { "label": "Online or in person" } },
    "place": { "piece": "place", "when": { "mode": ["in-person"] }, "ask": { "label": "Area", "start": { "radiusKm": 5 } } },
    "hours": { "piece": "date", "several": true, "ask": { "label": "Days and times", "start": { "way": "weekly", "hours": true } } }
  },
  "preview": ["subjects", "description", "price", "mode", "place"]
}
