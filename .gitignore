# The standard at the commit in STANDARD, and the markets at the commit in MARKETS, fetched by standard.sh
/standard/
/markets/

node_modules/

# What the host and the MCP server keep when run by hand (DATA_DIR=./data): the MCP server's key
# among it. The verifier's and the index's are in their directories' own .gitignore.
host/data/
mcp/data/

# Settings that may hold a key never enter the repo
.env
.env.*
